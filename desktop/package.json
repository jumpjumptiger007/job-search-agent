{
  "name": "job-search-agent-desktop",
  "productName": "Job Search Agent",
  "version": "0.9.1",
  "private": true,
  "description": "Desktop shell for the local Job Search Agent workspace",
  "main": "main.cjs",
  "config": { "forge": "./forge.config.cjs" },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package --arch=arm64",
    "dmg": "electron-forge make --platform=darwin --arch=arm64 --targets=@electron-forge/maker-dmg",
    "test": "node --test workspace-selfcheck.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "electron": "44.4.0"
  }
}
